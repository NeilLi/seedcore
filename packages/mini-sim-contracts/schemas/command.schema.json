{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mini Lab simulation commands v2",
  "description": "Stateful sequence, digest, capacity and applied-tick checks additionally enforced by the worker. Recycle is a separate binary ownership message described in README.md.",
  "$defs": {
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "strength",
        "motors",
        "mass",
        "gravity"
      ],
      "properties": {
        "target": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": -3.141592653589793,
            "maximum": 3.141592653589793
          }
        },
        "strength": {
          "type": "number",
          "minimum": 1,
          "maximum": 20
        },
        "motors": {
          "type": "boolean"
        },
        "mass": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 2
        },
        "gravity": {
          "type": "boolean"
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "strength",
        "motors"
      ],
      "properties": {
        "target": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": -3.141592653589793,
            "maximum": 3.141592653589793
          }
        },
        "strength": {
          "type": "number",
          "minimum": 1,
          "maximum": 20
        },
        "motors": {
          "type": "boolean"
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "engine",
        "buildDigest",
        "modelDigest",
        "recipeDigest",
        "tick",
        "state",
        "control",
        "started",
        "inputs"
      ],
      "properties": {
        "schema": {
          "const": "seedcore.mini-lab.checkpoint.v1"
        },
        "engine": {
          "const": "0.1.0-planar-arm"
        },
        "buildDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "modelDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "recipeDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "tick": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2880,
          "multipleOf": 8
        },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "q",
            "velocity",
            "time"
          ],
          "properties": {
            "q": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number",
                "minimum": -1000000.0,
                "maximum": 1000000.0
              }
            },
            "velocity": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number",
                "minimum": -1000000.0,
                "maximum": 1000000.0
              }
            },
            "time": {
              "type": "number",
              "minimum": 0,
              "maximum": 6.0000000001
            }
          }
        },
        "control": {
          "$ref": "#/$defs/control"
        },
        "started": {
          "type": "boolean"
        },
        "inputs": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sequence",
              "applicationTick",
              "control"
            ],
            "properties": {
              "sequence": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "applicationTick": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2879
              },
              "control": {
                "$ref": "#/$defs/control"
              }
            }
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "runId",
        "revision",
        "sequence",
        "applicationTick",
        "modelDigest",
        "recipeDigest",
        "type",
        "settings"
      ],
      "properties": {
        "protocol": {
          "const": "seedcore.mini-lab.worker.v2"
        },
        "runId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "applicationTick": {
          "const": 0
        },
        "modelDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "recipeDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "type": {
          "const": "reset"
        },
        "settings": {
          "$ref": "#/$defs/settings"
        }
      }
    },
