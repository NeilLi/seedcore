{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mini Lab simulation commands v2",
  "description": "Stateful sequence, digest, capacity and applied-tick checks additionally enforced by the worker. Recycle is a separate binary ownership message described in README.md.",
  "$defs": {
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "strength",
        "motors",
        "mass",
        "gravity"
      ],
      "properties": {
        "target": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": -3.141592653589793,
            "maximum": 3.141592653589793
          }
        },
        "strength": {
          "type": "number",
          "minimum": 1,
          "maximum": 20
        },
        "motors": {
          "type": "boolean"
        },
        "mass": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 2
        },
        "gravity": {
          "type": "boolean"
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "strength",
        "motors"
      ],
      "properties": {
        "target": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": -3.141592653589793,
            "maximum": 3.141592653589793
          }
        },
        "strength": {
          "type": "number",
          "minimum": 1,
          "maximum": 20
        },
        "motors": {
          "type": "boolean"
        }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "runId",
        "revision",
        "sequence",
        "applicationTick",
        "modelDigest",
        "recipeDigest",
        "type",
        "settings"
      ],
      "properties": {
        "protocol": {
          "const": "seedcore.mini-lab.worker.v2"
        },
        "runId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "applicationTick": {
          "const": 0
        },
        "modelDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "recipeDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "type": {
          "const": "reset"
        },
        "settings": {
          "$ref": "#/$defs/settings"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "runId",
        "revision",
        "sequence",
        "applicationTick",
        "modelDigest",
        "recipeDigest",
        "type"
      ],
      "properties": {
        "protocol": {
          "const": "seedcore.mini-lab.worker.v2"
        },
        "runId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "applicationTick": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2880
        },
        "modelDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "recipeDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "type": {
          "const": "start"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "runId",
        "revision",
        "sequence",
        "applicationTick",
        "modelDigest",
        "recipeDigest",
        "type"
      ],
      "properties": {
        "protocol": {
          "const": "seedcore.mini-lab.worker.v2"
        },
        "runId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "applicationTick": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2880
        },
        "modelDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "recipeDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "type": {
          "const": "pause"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "runId",
        "revision",
        "sequence",
        "applicationTick",
        "modelDigest",
        "recipeDigest",
        "type"
      ],
      "properties": {
        "protocol": {
          "const": "seedcore.mini-lab.worker.v2"
        },
        "runId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "applicationTick": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2880
        },
        "modelDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "recipeDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "type": {
          "const": "step"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "runId",
        "revision",
        "sequence",
        "applicationTick",
        "modelDigest",
        "recipeDigest",
        "type",
        "control"
      ],
      "properties": {
        "protocol": {
          "const": "seedcore.mini-lab.worker.v2"
        },
        "runId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "applicationTick": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2879
        },
        "modelDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "recipeDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "type": {
          "const": "set-control"
        },
        "control": {
          "$ref": "#/$defs/control"
        }
      }
    }
  ]
}
