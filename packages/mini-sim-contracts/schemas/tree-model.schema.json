{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kinematic Tree Model Descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "modelId",
    "numLinks",
    "links",
    "gravity"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "seedcore.mini-sim.tree-model.v1"
    },
    "modelId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "numLinks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "gravity": {
      "type": "number",
      "minimum": 0,
      "maximum": 50
    },
    "links": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "length",
          "mass",
          "com",
          "inertia",
          "damping"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "length": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 10
          },
          "mass": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 100
          },
          "com": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          },
          "inertia": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 100
          },
          "damping": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "jointLimits": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          }
        }
      }
    },
    "encoders": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "joint_pos",
          "joint_vel",
          "tip_pos",
          "energy"
        ]
      }
    }
  }
}
